# Default: browser calls /backend-api (same origin); Next rewrites to FastAPI.
# BACKEND_URL=http://127.0.0.1:8000
# Production builds also read `.env.production` (see repo). Override in Vercel/Railway env if needed.
# Only if your API is on another host (then you must fix CORS on the API):
# NEXT_PUBLIC_API_URL=https://example.com/api
