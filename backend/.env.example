# Option A — recommended if password has @, #, etc. (no URL encoding needed)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cgpa_tracker

# Option B — single URL (encode @ as %40 in the password part)
# DATABASE_URL=postgresql://postgres:encoded_password@127.0.0.1:5432/cgpa_tracker

JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Production: comma-separated frontend origins (https://your-app.vercel.app). Localhost still allowed in dev.
# CORS_ORIGINS=https://cgpa.example.com
